# Next.js static export gives every route its own real .html file (e.g.
# /en/services/web -> en/services/web.html) — there is no client-side-only
# routing to fall back to anymore, so this maps clean URLs to those files
# instead of routing everything through one index.html like the old SPA did.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories (JS/CSS/images/sitemap.xml/etc.) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL -> matching .html file, trailing slash optional.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# A genuinely missing page now returns a real 404 status (not a 200 "soft
# 404"), since every valid route already matched a real file above.
ErrorDocument 404 /404.html

# Cache hashed static assets aggressively; never cache the HTML pages
# themselves (they must always be re-fetched so deploys show up immediately).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
