# SPA fallback: this app handles routing client-side (react-router), so any
# URL that isn't a real file on disk (e.g. /en, /de/services/web) must still
# be served index.html — otherwise the server 404s before React ever loads.
# Without this, Googlebot gets a real 404 for every non-root URL, which is
# why /en, /de, /pl (and every /services/* page) were unreachable.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories (JS/CSS/images/sitemap.xml/etc.) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes through index.html so react-router can render it.
  RewriteRule ^ /index.html [L]
</IfModule>

# Cache hashed static assets aggressively; never cache index.html itself
# (it must always be re-fetched so deploys show up immediately).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
