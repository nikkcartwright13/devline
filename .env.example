# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to keep analytics disabled and hide the cookie consent banner.
NEXT_PUBLIC_GA_ID=

# EmailJS (emailjs.com) — used by the contact form to send messages directly.
# Create a Service + Template + Public Key at https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
